  "narrative": {
    "northStar": "A Living Mars Colony",
    "overview": "A warm, mineral world carries the experience: rust terrain, a dusty horizon, pale habitats, dark machinery, and restrained cyan equipment lights. Alien residents make the settlement feel inhabited while compact controls keep task context close. This is a stylized fictional planet, not a scientific Mars simulator.\n\nThe world stays visually dominant from surface to orbit. Floating paper-like controls provide readable anchors above the scenery; existing sage task surfaces remain part of the implemented interface. Decorative life and factual task state have separate meanings. Expedition Base's approved Blender reference now establishes the material and authored-detail standard across the active world: colony hardware, scientific facilities, space vehicles, resident equipment, terrain, and orbital assets. This rollout extends the existing Mars colony identity while preserving the interface's tokens and layout.",
    "keyCharacteristics": [
      "Warm mineral landscape with pale engineered structures.",
      "Worn materials at a fixed world scale, grounded foundations, and authored equipment detail.",
      "Small cyan accents identify equipment and navigation beacons.",
      "World-first composition with compact floating controls.",
      "Task labels and attention remain grounded in real session state."
    ],
    "rules": [
      {
        "name": "The Signal Accent Rule",
        "body": "Keep cyan concentrated in equipment lights and small navigation cues; the mineral world supplies the dominant color.",
        "section": "colors"
      },
      {
        "name": "The Physical Scale Rule",
        "body": "Keep material grain at a stable world scale; camera zoom must not resize it. Use local coordinates for moving resident parts.",
        "section": "elevation"
      },
      {
        "name": "The Ground Contact Rule",
        "body": "Support pads and equipment on rendered terrain and preserve route clearance and arrival sightlines when changing geometry or placement.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep terrain, habitat silhouettes, and residents readable behind the controls.",
      "Do preserve opaque paper behind camera navigation and its dark brown labels.",
      "Do use text and state semantics alongside status color.",
      "Do preserve route clearance and arriving-resident sightlines when extending structures.",
      "Do maintain fixed material scale and terrain contact across authored and procedural assets.",
      "Do reuse the shared hardware modules and keep editable Blender parts separate from export optimization.",
      "Do honor reduced motion for orbital entry and ambient spacecraft."
    ],
    "donts": [
      "Don't let decorative journeys, equipment, or flight cycles imply provider activity.",
      "Don't replace unknown task state with invented progress or completion.",
      "Don't spread emissive cyan across large terrain or interface surfaces.",
      "Don't turn the fictional planet into a claim of scientific Mars accuracy."
    ]
  }
}
